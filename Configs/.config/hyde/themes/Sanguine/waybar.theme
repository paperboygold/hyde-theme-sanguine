$HOME/.config/waybar/theme.css|${scrDir}/wbarconfgen.sh
@define-color bar-bg rgba(18, 10, 10, 0.95);

@define-color main-bg #120a0a;
@define-color main-fg #d4a753;

@define-color wb-act-bg #a52a2a;
@define-color wb-act-fg #fcf8f8;

@define-color wb-hvr-bg #d4a753;
@define-color wb-hvr-fg #120a0a;
